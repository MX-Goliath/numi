{
  "name": "numi-desktop",
  "version": "0.1.15",
  "author": "nyko",
  "description": "Numi desktop calculator, restored from the 0.1.15 release.",
  "main": "main.js",
  "license": "Commercial",
  "scripts": {
    "build:native": "node scripts/build-native.cjs",
    "build:ui": "vite build",
    "build": "npm run build:native && npm run build:ui",
    "start": "npm run build && electron .",
    "dev": "npm run build:native && concurrently -k \"vite\" \"wait-on http://localhost:3000 && electron . --dev\"",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make",
    "test": "node --test test/*.test.cjs",
    "test:engine": "cargo test --locked --manifest-path numi-module/numi-rs/Cargo.toml",
    "test:smoke": "npm run build && electron . --smoke-test",
    "appimage": "npm run build && electron-builder --linux AppImage --x64",
    "windows": "npm run build && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "9.2.1",
    "electron": "44.7.0",
    "electron-builder": "^26.0.12",
    "vite": "8.3.4",
    "wait-on": "9.0.3"
  },
  "dependencies": {
    "electron-settings": "4.0.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "productName": "Numi",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "build": {
    "appId": "local.numi.desktop",
    "productName": "Numi",
    "asar": true,
    "asarUnpack": [
      "numi-module/**/*.node"
    ],
    "files": [
      "dist/**/*",
      "assets/**/*",
      "main.js",
      "preload.js",
      "numi-module/index.node",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "assets/icons/png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icons/win/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "output": "artifacts"
    }
  }
}
